# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 공개 저장소에 올라가지 않습니다.
SCHOOL_YEAR=2027
# 아이 출생연도(선택). 생년월일 전체는 필요 없습니다.
CHILD_BIRTH_YEAR=
# 유치원알리미 Open API 인증키
KINDER_API_KEY=
# 충청남도 44, 아산시 44200 (첫 조회 때 건수로 확인)
KINDER_SIDO_CODE=44
KINDER_SGG_CODE=44200
# 어린이집 API: 명세서에서 확인한 요청 주소를 그대로 넣고 인증키 자리를 {KEY} 로 바꿉니다
CHILDCARE_API_URL=
CHILDCARE_API_KEY=
